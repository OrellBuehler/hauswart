{
  "name": "hauswart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun scripts/i18n-compile.ts && bun --bun vite build && bun scripts/build-markdown-worker.ts",
    "preview": "bun --bun vite preview",
    "start": "NODE_ENV=production bun ./build/index.js",
    "i18n": "bun scripts/i18n-compile.ts",
    "prepare": "(bun scripts/i18n-compile.ts; svelte-kit sync) || echo \"\"",
    "check": "bun scripts/i18n-compile.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "security": "./scripts/security/scan-all.sh",
    "security:install": "./scripts/security/install-tools.sh",
    "openapi": "bun scripts/gen-openapi.ts",
    "leak-guard": "bun scripts/leak-guard.ts",
    "mcp": "bun mcp/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/pdfmake": "^0.3.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.3",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.1",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "drizzle-orm": "^0.45.3",
    "marked": "^18.1.0",
    "qrcode": "^1.5.4",
    "pdfmake": "^0.3.11",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
