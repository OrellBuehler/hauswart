# 32 random bytes, base64 (generate with: openssl rand -base64 32). Required in production.
HAUSWART_SECRET_KEY=

DATABASE_PATH=./data/hauswart.db

# Optional: first-run setup then asks for this value, so nobody who finds a fresh instance first
# can claim the administrator account. Ignored once a user exists.
# HAUSWART_SETUP_TOKEN=

# Uploaded documents and photos.
HAUSWART_FILES_DIR=./data/files

# Backups: a daily copy of the database, and the uploaded files mirrored into <dir>/files. Set the
# directory empty to turn them off; keep is how many database copies to keep.
HAUSWART_BACKUP_DIR=./data/backups
HAUSWART_BACKUP_KEEP=14

# Household time zone: calendar dates (due dates, reminders) are evaluated in it.
HAUSWART_TZ=Europe/Zurich

# Set to false only when serving over plain HTTP (e.g. a LAN setup).
# HAUSWART_COOKIE_SECURE=false

# Reverse proxy (svelte-adapter-bun). ORIGIN must match the public URL, also on
# plain HTTP (the adapter assumes https without it): sign-in and every other
# cookie-authenticated API request check the Origin header against it and fail
# with 403 csrf_failed otherwise.
# Login rate limiting keys on the client address: behind a proxy set
# ADDRESS_HEADER (e.g. X-Forwarded-For) and XFF_DEPTH (number of trusted proxies),
# otherwise every client appears as the proxy and shares one limit.
# ORIGIN=https://hauswart.example.org
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Largest request body the server accepts (svelte-adapter-bun; its default is 512K). Uploads are
# limited to 25 MiB per file, so the Docker image sets 30M to leave room for the multipart
# overhead. Set it yourself when running `bun run start` outside Docker and uploading files.
# BODY_SIZE_LIMIT=30M
