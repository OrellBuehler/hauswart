{
  "extends": "$app/tsconfig",
  "include": [
    ".svelte-kit/types/**/$types.d.ts",
    "vite.config.ts",
    "kit.config.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "mcp/**/*.ts"
  ],
  "compilerOptions": {
    "sourceMap": true,
    "strict": true
  },
  "exclude": ["src/service-worker"]
}
